# prototype | launch
SITE_MODE=prototype
SITE_URL=http://localhost:4321

# Enquiry storage (SQLite file, created on first use). Keep outside the web root.
ENQUIRY_DB_PATH=./data/enquiries.db
ENQUIRY_RETENTION_DAYS=90

# Enquiry notifications: "log" (development) or "resend"
NOTIFY_PROVIDER=log
NOTIFY_FROM="Website enquiries <enquiries@example.com>"
NOTIFY_TO=
NOTIFY_BACKUP_TO=
RESEND_API_KEY=
# Send a short receipt to the visitor (true/false)
NOTIFY_ACKNOWLEDGE=false

# Editor in production (GitHub storage). Leave empty to disable /keystatic in production.
KEYSTATIC_GITHUB_REPO=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Set to true only when running behind a proxy/load balancer that sets X-Forwarded-For.
TRUST_PROXY=false
