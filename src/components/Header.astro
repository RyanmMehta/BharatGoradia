---
import { navItems, settings } from '../lib/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${settings.personName}, home`}>
      <span class="brand-name">{settings.personName}</span>
      {settings.businessName && <span class="brand-sub">{settings.businessName}</span>}
    </a>
    <nav aria-label="Main">
      <ul class="nav-list">
        {
          navItems.map((item) => (
            <li>
              <a class="nav-link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="nav-contact">
          <a class="button" href="/contact" aria-current={isCurrent('/contact') ? 'page' : undefined}>
            Contact Bharat
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--ivory);
    border-bottom: 1px solid var(--line);
  }

  /* Sticky only where there is room for it, so it never covers headings or focused controls on small screens. */
  @media (min-width: 64rem) and (min-height: 40rem) {
    .site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgb(250 247 240 / 0.97);
      transition: box-shadow 150ms ease;
    }
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 0.75rem;
  }

  .brand {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: var(--target);
    color: var(--charcoal);
    text-decoration: none;
    line-height: 1.15;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .brand-sub {
    font-size: var(--text-small);
    color: var(--charcoal-soft);
    letter-spacing: 0.02em;
  }

  /* Every destination stays visible as text at all sizes: no hidden menu to discover. */
  .nav-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    padding: 0 0.75rem;
    color: var(--charcoal);
    font-size: var(--text-support);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 3px solid transparent;
  }

  .nav-link:hover {
    color: var(--burgundy);
    border-bottom-color: var(--gold);
  }

  .nav-link[aria-current='page'] {
    color: var(--burgundy);
    border-bottom-color: var(--burgundy);
  }

  .nav-contact {
    margin-left: 0.5rem;
  }

  .nav-contact .button[aria-current='page'] {
    box-shadow: 0 0 0 3px var(--ivory), 0 0 0 5px var(--gold);
  }

  @media (max-width: 47.99rem) {
    .header-inner {
      padding-block: 0.5rem 0.25rem;
    }
    nav {
      width: 100%;
    }
    .nav-list {
      margin-inline: -0.75rem;
    }
    /* Contact stays a full-width primary action directly under the name on phones. */
    .nav-contact {
      order: -1;
      width: 100%;
      margin: 0 0.75rem 0.25rem;
    }
    .nav-contact .button {
      width: 100%;
    }
  }
</style>
