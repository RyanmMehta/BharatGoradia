---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatPartialDate } from '../lib/site';

interface Props {
  entry: CollectionEntry<'awards'>;
  /** Detailed rows (Recognition page) show the photo and any supporting link. */
  detailed?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { entry, detailed = false, headingLevel = 'h3' } = Astro.props;
const { data } = entry;
const Heading = headingLevel;
// Only public fields are read here. data.evidence is a private editorial record and is never rendered.
const year = data.date ? data.date.slice(0, 4) : '';
const meta = [data.issuer, data.location, data.date.length > 4 ? formatPartialDate(data.date) : ''].filter(Boolean);
---

<article class:list={['honour', detailed && 'is-detailed', data.image && detailed && 'has-photo', !year && 'no-date']}>
  {year && <div class="honour-year">{year}</div>}
  <div class="honour-body">
    <p class="honour-kind">
      {data.kind === 'honour' ? 'Honour' : 'Award'}
      {data.placeholder && <span class="sample-text">· Sample</span>}
    </p>
    <Heading class="honour-title">{data.title}</Heading>
    {meta.length > 0 && <p class="honour-meta">{meta.join(' · ')}</p>}
    <p class="honour-desc">{data.description}</p>
    {detailed && data.link && <a class="more" href={data.link}>{data.linkLabel || 'Read more about this award'} <span class="arrow" aria-hidden="true">→</span></a>}
  </div>
  {
    detailed && data.image && (
      <div class="photo honour-photo reveal">
        <Image src={data.image} alt={data.imageAlt} widths={[480, 800]} sizes="(min-width: 48rem) 22rem, 100vw" loading="lazy" />
        {data.placeholder && <span class="sample-chip">Sample</span>}
      </div>
    )
  }
</article>

<style>
  .honour {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0 1.5rem;
    padding: 2rem 0;
    border-top: 1px solid var(--line);
  }
  .honour-year {
    font-family: var(--font-display);
    font-size: 2.25rem;
    line-height: 1;
    color: var(--accent);
  }
  /* Undated entries never get an invented date: the year column is simply left out. */
  .honour.no-date {
    grid-template-columns: 1fr;
  }
  .no-date .honour-photo {
    grid-column: 1;
  }
  .honour-kind {
    margin: 0 0 0.4rem;
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .sample-text {
    margin-left: 0.35em;
    color: var(--text-2);
    letter-spacing: 0.06em;
  }
  .honour-title {
    margin-bottom: 0.35rem;
    font-size: var(--display-m);
  }
  .honour-meta {
    margin-bottom: 0.6rem;
    font-weight: 700;
    color: var(--text-2);
  }
  .honour-desc {
    margin-bottom: 0;
  }
  .honour .more {
    margin-top: 1rem;
  }
  .honour-photo {
    grid-column: 2;
    margin-top: 1.5rem;
    aspect-ratio: 3 / 2;
  }
  @media (max-width: 30rem) {
    .honour {
      grid-template-columns: 1fr;
    }
    .honour-year {
      margin-bottom: 0.75rem;
    }
    .honour-photo {
      grid-column: 1;
    }
  }
  @media (min-width: 56rem) {
    .is-detailed.has-photo {
      grid-template-columns: 5.5rem 1fr 20rem;
    }
    .is-detailed.has-photo.no-date {
      grid-template-columns: 1fr 20rem;
    }
    .no-date.is-detailed .honour-photo {
      grid-column: 2;
    }
    .is-detailed .honour-photo {
      grid-column: 3;
      grid-row: 1;
      margin-top: 0;
    }
  }
</style>
