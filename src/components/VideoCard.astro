---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'videos'>;
  headingLevel?: 'h2' | 'h3' | 'h4';
  sizes?: string;
  /** Hide the description (used for the smaller homepage videos). */
  compact?: boolean;
}
const { entry, headingLevel = 'h3', compact = false, sizes = '(min-width: 64rem) 26rem, (min-width: 40rem) 45vw, 100vw' } = Astro.props;
const { data } = entry;
const video = data;
const Heading = headingLevel;

const typeLabel = {
  interview: 'Interview',
  event: 'Event highlight',
  testimonial: 'Testimonial',
  greeting: 'Greeting',
}[data.videoType ?? 'event'];

function spokenDuration(d: string) {
  const parts = d.split(':').map(Number);
  const [h, m, s] = parts.length === 3 ? parts : [0, ...parts];
  const out = [];
  if (h) out.push(`${h} hour${h === 1 ? '' : 's'}`);
  if (m) out.push(`${m} minute${m === 1 ? '' : 's'}`);
  if (s) out.push(`${s} second${s === 1 ? '' : 's'}`);
  return out.join(' ');
}

const youtubeUrl = video.youtubeId ? `https://www.youtube.com/watch?v=${video.youtubeId}` : undefined;
const sourceUrl = data.sourceUrl ?? youtubeUrl ?? (video.fileUrl || undefined);
const sourceLabel =
  data.sourceLabel || (video.provider === 'youtube' ? 'Watch on YouTube' : video.provider === 'file' ? 'Open video file' : 'Watch at source');
const playable = video.provider === 'youtube' ? Boolean(video.youtubeId) : video.provider === 'file' ? Boolean(video.fileUrl) : false;
const facadeHref = sourceUrl;
const playLabel = video.duration ? `Play video: ${data.title}, ${spokenDuration(video.duration)}` : `Play video: ${data.title}`;
// Without a cover image, a YouTube video shows YouTube's own thumbnail. The full-size one does not
// exist for every video, so the small handler falls back to the standard size (YouTube answers a
// missing thumbnail with a 120px grey placeholder rather than always with an error).
const thumb = !data.poster && video.youtubeId ? `https://i.ytimg.com/vi/${video.youtubeId}` : undefined;
const thumbFallback = "if(this.naturalWidth<=120&&this.src!==this.dataset.fallback)this.src=this.dataset.fallback";
---

<article
  class="video-card"
  data-video-card
  data-id={entry.id}
  data-provider={video.provider}
  data-youtube-id={video.youtubeId}
  data-file-url={video.fileUrl || undefined}
  data-captions-url={video.captionsUrl || undefined}
  data-title={data.title}
>
  <div class:list={['video-stage', `video-${video.orientation}`]} data-video-stage>
    {
      facadeHref ? (
        <a class="video-facade" href={facadeHref} data-video-facade={playable ? '' : undefined} aria-label={playLabel}>
          {data.poster ? (
            <Image src={data.poster} alt="" widths={[480, 800, 1200]} sizes={sizes} loading="lazy" />
          ) : (
            thumb && (
              <img
                src={`${thumb}/maxresdefault.jpg`}
                data-fallback={`${thumb}/hqdefault.jpg`}
                alt=""
                width="1280"
                height="720"
                loading="lazy"
                decoding="async"
                onload={thumbFallback}
                onerror={`this.onerror=null;${thumbFallback.replace('this.naturalWidth<=120&&', '')}`}
              />
            )
          )}
          <span class="play" aria-hidden="true">
            <span class="play-disc"><svg viewBox="0 0 24 24" width="30" height="30"><path d="M8 5v14l11-7z" fill="currentColor" /></svg></span>
            <span class="play-text">Play</span>
          </span>
          {data.placeholder && <span class="sample-chip">Sample</span>}
        </a>
      ) : (
        <div class="video-facade is-unavailable">
          {data.poster && <Image src={data.poster} alt="" widths={[480, 800, 1200]} sizes={sizes} loading="lazy" />}
          <span class="play is-muted" aria-hidden="true">
            <span class="play-disc"><svg viewBox="0 0 24 24" width="30" height="30"><path d="M8 5v14l11-7z" fill="currentColor" /></svg></span>
          </span>
          <span class="unavailable-note">Video coming soon</span>
          {data.placeholder && <span class="sample-chip">Sample</span>}
        </div>
      )
    }
  </div>
  <div class="video-body">
    <p class="video-meta">
      <span>{typeLabel}</span>
      {video.duration && (
        <>
          {' · '}
          <span><span aria-hidden="true">{video.duration}</span><span class="visually-hidden">{spokenDuration(video.duration)}</span></span>
        </>
      )}
    </p>
    <Heading class="video-title">{data.title}</Heading>
    {!compact && <p class="video-desc">{data.description}</p>}
    <p class="video-status" role="status" data-video-status></p>
    {sourceUrl && <a class="text-link-arrow" href={sourceUrl} data-track="video_source_click" data-track-id={entry.id}>{sourceLabel}</a>}
  </div>
</article>

<script>
  import { initVideos } from '../scripts/video';
  initVideos();
</script>

<style>
  .video-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: var(--text);
  }
  .video-stage {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--black);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 0 0 1px var(--line);
  }
  /* Vertical footage keeps its own 9:16 shape inside the frame instead of being cropped. */
  .video-stage.video-portrait > :global(*) {
    position: absolute;
    inset: 0;
    margin-inline: auto;
    width: auto;
    height: 100%;
    aspect-ratio: 9 / 16;
  }
  .video-facade {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    color: var(--text);
  }
  .video-facade :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.2, 0.7, 0.2, 1), opacity 200ms ease;
  }
  .video-facade:hover :global(img) {
    transform: scale(1.03);
    opacity: 0.85;
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    justify-items: center;
    gap: 0.5rem;
  }
  .play-disc {
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    padding-left: 4px;
    border-radius: 50%;
    background: var(--marigold);
    color: var(--deep);
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.45), 0 0 0 8px rgb(233 162 59 / 0.22);
    transition: transform 180ms ease, background-color 180ms ease;
  }
  .play-text {
    padding: 0.1rem 0.7rem;
    border-radius: 3px;
    background: rgb(11 8 7 / 0.7);
    font-weight: 700;
    font-size: var(--text-support);
  }
  .video-facade:hover .play-disc,
  .video-facade:focus-visible .play-disc {
    transform: scale(1.07);
    background: var(--text);
  }
  /* A soft marigold ring pulses outward while the video is hovered or focused */
  @keyframes ring-pulse {
    from {
      box-shadow: 0 6px 24px rgb(0 0 0 / 0.45), 0 0 0 0 rgb(233 162 59 / 0.6);
    }
    to {
      box-shadow: 0 6px 24px rgb(0 0 0 / 0.45), 0 0 0 22px rgb(233 162 59 / 0);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .video-facade:hover .play-disc,
    .video-facade:focus-visible .play-disc {
      animation: ring-pulse 1.4s ease-out infinite;
    }
  }
  .play.is-muted .play-disc {
    opacity: 0.55;
    box-shadow: none;
  }
  .unavailable-note {
    position: absolute;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    white-space: nowrap;
    padding: 0.3rem 0.8rem;
    background: rgb(0 0 0 / 0.75);
    border-radius: 4px;
  }
  .video-stage :global(iframe),
  .video-stage :global(video) {
    width: 100%;
    height: 100%;
    border: 0;
    background: var(--black);
  }
  .video-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding-top: 1.1rem;
  }
  .video-meta {
    margin: 0 0 0.35rem;
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--marigold);
  }
  .video-title {
    margin-bottom: 0.4rem;
    color: var(--text);
  }
  .video-desc {
    color: var(--text-2);
    margin-bottom: 0.75rem;
  }
  .video-status:empty {
    display: none;
  }
  .video-status {
    padding: 0.75rem 1rem;
    border-left: 4px solid var(--marigold);
    background: var(--surface-2);
    font-size: var(--text-support);
  }
  .text-link-arrow {
    align-self: flex-start;
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
  }
</style>
