---
interface Props {
  credit: string;
  title: string;
  lead?: string;
}
const { credit, title, lead } = Astro.props;
---

<header class="page-header">
  <div class="wrap">
    <p class="credit enter">{credit}</p>
    <h1 class="enter enter-2">{title}</h1>
    {lead && <p class="lead enter enter-3">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-header {
    padding-block: clamp(2.5rem, 2rem + 3vw, 4.5rem) clamp(2rem, 1.5rem + 2vw, 3.25rem);
    border-bottom: 2px solid var(--ink);
  }
  h1 {
    font-size: var(--display-l);
    line-height: 1;
    letter-spacing: -0.02em;
    margin-bottom: 0;
    max-width: 18ch;
  }
  .lead {
    margin-top: 1.25rem;
  }
  .lead {
    max-width: 36em;
    margin: 0;
  }
</style>
