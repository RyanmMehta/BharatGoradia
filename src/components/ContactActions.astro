---
import { isPrototype, settings, unconfirmed } from '../lib/site';

interface Props {
  /** "large" on paper, "red" inside the sindoor contact band. */
  variant?: 'large' | 'red';
  /** Context for analytics, e.g. "contact-page", "home", "footer". */
  location: string;
}
const { variant = 'large', location } = Astro.props;
const sample = (key: string) => isPrototype && unconfirmed(key);
const phone = settings.phone.show && settings.phone.tel ? settings.phone : null;
const secondary = 'button button-outline';
---

<ul class:list={['contact', `contact-${variant}`]} data-contact-actions>
  <li class="item item-email">
    <span class="label">Email {sample('email') && <span class="sample-text">· Sample address</span>}</span>
    <span class="value" data-email-text>{settings.email}</span>
    <span class="actions">
      <a class="button" href={`mailto:${settings.email}`} data-track="contact_email_click" data-track-id={location}>Email Bharat</a>
      <button type="button" class={secondary} data-copy-email hidden>Copy address</button>
    </span>
    <span class="copy-status" role="status" data-copy-status></span>
  </li>
  <li class="item">
    <span class="label">Instagram {sample('instagram') && <span class="sample-text">· Sample</span>}</span>
    <span class="value">{settings.instagram.handle}</span>
    <span class="actions">
      <a class={secondary} href={settings.instagram.url} data-track="social_click" data-track-id={`instagram:${location}`}>Open Instagram</a>
    </span>
  </li>
  <li class="item">
    <span class="label">Facebook {sample('facebook') && <span class="sample-text">· Sample</span>}</span>
    <span class="value">{settings.facebook.name}</span>
    <span class="actions">
      <a class={secondary} href={settings.facebook.url} data-track="social_click" data-track-id={`facebook:${location}`}>Open Facebook</a>
    </span>
  </li>
  {
    phone && (
      <li class="item">
        <span class="label">Telephone</span>
        <span class="value">{phone.display}</span>
        <span class="actions">
          <a class={secondary} href={`tel:${phone.tel}`} data-track="phone_click" data-track-id={location}>
            Call Bharat
          </a>
        </span>
      </li>
    )
  }
</ul>

<script>
  import { track } from '../scripts/analytics';

  // Copy email: progressive enhancement. The address stays visible and selectable either way.
  document.querySelectorAll<HTMLElement>('[data-contact-actions]').forEach((list) => {
    const button = list.querySelector<HTMLButtonElement>('[data-copy-email]');
    const status = list.querySelector<HTMLElement>('[data-copy-status]');
    const text = list.querySelector<HTMLElement>('[data-email-text]');
    if (!button || !status || !text || !navigator.clipboard) return;
    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(text.textContent?.trim() ?? '');
        status.textContent = 'Email address copied.';
        track('contact_email_copy');
      } catch {
        status.textContent = 'Could not copy automatically. Please select the email address above and copy it.';
        const range = document.createRange();
        range.selectNodeContents(text);
        const sel = getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
      }
    });
  });
</script>

<style>
  .contact {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .item {
    display: grid;
    gap: 0.2rem 2rem;
    padding: 1.6rem 0;
    border-top: 1px solid var(--rule);
  }
  .item:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .label {
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sindoor);
  }
  .sample-text {
    color: var(--ink-2);
    letter-spacing: 0.04em;
    text-transform: none;
    font-weight: 400;
  }
  .value {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.5rem);
    line-height: 1.15;
    overflow-wrap: anywhere;
    user-select: all;
    -webkit-user-select: all;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .copy-status:empty {
    display: none;
  }
  .copy-status {
    font-weight: 700;
    color: var(--sindoor);
  }
  @media (min-width: 52rem) {
    .contact-large .item,
    .contact-red .item {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
    .contact-large .label,
    .contact-large .value,
    .contact-red .label,
    .contact-red .value {
      grid-column: 1;
    }
    .contact-large .actions,
    .contact-red .actions {
      grid-column: 2;
      grid-row: 1 / span 2;
      margin: 0;
      justify-content: flex-end;
    }
    .contact-large .copy-status,
    .contact-red .copy-status {
      grid-column: 1 / -1;
    }
  }

  /* Inside the sindoor contact band */
  .contact-red .item {
    border-color: rgb(247 241 230 / 0.25);
  }
  .contact-red .label {
    color: var(--marigold-soft);
  }
  .contact-red .sample-text {
    color: var(--marigold-soft);
  }
  .contact-red .copy-status {
    color: var(--marigold-soft);
  }
  .contact-red .item-email .value {
    font-size: clamp(1.75rem, 1.2rem + 2.4vw, 3.5rem);
  }

</style>
