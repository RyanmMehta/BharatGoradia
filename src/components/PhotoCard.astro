---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatPartialDate } from '../lib/site';

interface Props {
  entry: CollectionEntry<'photos'>;
  headingLevel?: 'h2' | 'h3' | 'h4';
  /** Frame shape. "auto" keeps the photo's own proportions. */
  ratio?: 'auto' | 'landscape' | 'portrait' | 'square' | 'fill';
  sizes?: string;
  class?: string;
}
const {
  entry,
  headingLevel = 'h3',
  ratio = 'landscape',
  sizes = '(min-width: 64rem) 30rem, (min-width: 40rem) 45vw, 100vw',
  class: className,
} = Astro.props;
const { data } = entry;
const Heading = headingLevel;
const meta = [data.event, formatPartialDate(data.date)].filter(Boolean).join(' · ');
const style = ratio === 'auto' ? `aspect-ratio: ${data.image.width} / ${data.image.height}` : undefined;
---

<figure class:list={['photo-card', `ratio-${ratio}`, className]}>
  <div class="photo reveal" style={style}>
    <Image
      src={data.image}
      alt={data.alt}
      widths={[480, 720, 960, 1280, 1600]}
      sizes={sizes}
      loading="lazy"
      decoding="async"
      style={`object-position: ${data.focalPoint}`}
    />
    {data.placeholder && <span class="sample-chip">Sample</span>}
  </div>
  <figcaption>
    {data.people.length > 0 && <Heading class="people">{data.people.join(', ')}</Heading>}
    <p class="caption">{data.caption}</p>
    {meta && <p class="meta">{meta}</p>}
    {data.bharatRole && <p class="meta">Bharat's role: {data.bharatRole}</p>}
    {data.attribution && <p class="meta">Photo: {data.attribution}</p>}
  </figcaption>
</figure>

<style>
  .photo-card {
    display: flex;
    flex-direction: column;
    margin: 0;
    height: 100%;
  }
  .ratio-landscape .photo {
    aspect-ratio: 3 / 2;
  }
  .ratio-portrait .photo {
    aspect-ratio: 4 / 5;
  }
  .ratio-square .photo {
    aspect-ratio: 1;
  }
  .ratio-fill .photo {
    flex: 1;
    min-height: 18rem;
  }
  .photo-card:hover .photo :global(img) {
    transform: scale(1.025);
  }
  figcaption {
    padding-top: 1rem;
  }
  .people {
    margin: 0 0 0.3rem;
    font-family: var(--font-display);
    font-size: var(--display-s);
    line-height: 1.15;
  }
  .caption {
    margin: 0 0 0.4rem;
  }
  .meta {
    margin: 0;
    font-size: var(--text-support);
    color: var(--ink-2);
  }
</style>
