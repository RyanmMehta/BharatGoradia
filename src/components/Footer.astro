---
import Toran from './Toran.astro';
import { navItems, settings } from '../lib/site';
const year = new Date().getFullYear();
---

<footer class="site-footer on-night">
  <Toran tone="night" />
  <div class="wrap footer-main">
    <div class="footer-id">
      <p class="footer-name">{settings.personName}</p>
      {settings.businessName && <p class="credit">{settings.businessName}</p>}
    </div>
    <ul class="footer-contact" aria-label="Contact Bharat">
      <li>
        <a href={`mailto:${settings.email}`} data-track="contact_email_click" data-track-id="footer">{settings.email}</a>
      </li>
      <li>
        <a href={settings.instagram.url} data-track="social_click" data-track-id="instagram:footer">Instagram</a>
      </li>
      <li>
        <a href={settings.facebook.url} data-track="social_click" data-track-id="facebook:footer">Facebook</a>
      </li>
      {
        settings.phone.show && settings.phone.tel && (
          <li>
            <a href={`tel:${settings.phone.tel}`} data-track="phone_click" data-track-id="footer">
              {settings.phone.display}
            </a>
          </li>
        )
      }
    </ul>
  </div>
  <div class="wrap footer-base">
    <nav aria-label="Footer">
      <ul class="footer-links">
        {navItems.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/contact">Contact</a></li>
        <li><a href="/privacy">Privacy</a></li>
      </ul>
    </nav>
    <p>© {year} {settings.personName}{settings.footerNote && ` · ${settings.footerNote}`}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-bottom: 1.5rem;
  }
  .footer-main {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    padding-top: clamp(2.75rem, 2rem + 2vw, 4rem);
    padding-bottom: 2rem;
  }
  .footer-name {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.6rem + 1.2vw, 2.75rem);
    line-height: 1;
  }
  .footer-id .credit {
    margin: 0;
  }
  .footer-contact,
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer-contact a,
  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-weight: 700;
    color: var(--text);
    text-decoration-color: var(--marigold);
    overflow-wrap: anywhere;
  }
  .footer-contact a:hover,
  .footer-links a:hover {
    color: var(--marigold);
  }
  .footer-links a {
    font-size: var(--text-support);
    font-weight: 400;
    color: var(--text-2);
    text-decoration: none;
  }
  .footer-links a:hover {
    text-decoration: underline;
  }
  .footer-base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    color: var(--text-2);
    font-size: var(--text-support);
  }
  .footer-base p {
    margin: 0;
  }
</style>
