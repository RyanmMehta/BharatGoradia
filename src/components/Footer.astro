---
import Toran from './Toran.astro';
import { navItems, settings } from '../lib/site';
const year = new Date().getFullYear();
---

<footer class="site-footer on-night">
  <Toran tone="night" />
  <div class="wrap footer-base">
    <nav aria-label="Footer">
      <ul class="footer-links">
        {navItems.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/contact">Contact</a></li>
        <li><a href="/privacy">Privacy</a></li>
      </ul>
    </nav>
    <p>© {year} {settings.personName}{settings.footerNote && ` · ${settings.footerNote}`}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-bottom: 1.5rem;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-weight: 700;
    color: var(--text);
    text-decoration-color: var(--marigold);
    overflow-wrap: anywhere;
  }
  .footer-links a:hover {
    color: var(--marigold);
  }
  .footer-links a {
    font-size: var(--text-support);
    font-weight: 400;
    color: var(--text-2);
    text-decoration: none;
  }
  .footer-links a:hover {
    text-decoration: underline;
  }
  .footer-base {
    display: flex;
    margin-top: 1.25rem;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-top: 0.5rem;
    color: var(--text-2);
    font-size: var(--text-support);
  }
  .footer-base p {
    margin: 0;
  }
</style>
