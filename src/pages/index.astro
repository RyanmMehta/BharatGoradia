---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PhotoCard from '../components/PhotoCard.astro';
import VideoCard from '../components/VideoCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import Diya from '../components/Diya.astro';
import { formatPartialDate, homepage, isPrototype, selected, settings, unconfirmed } from '../lib/site';

// The homepage is deliberately short: who he is, his achievements, his work, one voice, and how to reach him.
const [allPhotos, videos, allAwards, testimonials] = await Promise.all([
  selected('photos', homepage.artistPhotos),
  selected('videos', homepage.featuredVideos),
  selected('awards', homepage.awards),
  selected('testimonials', homepage.testimonials),
]);
const photos = allPhotos.slice(0, 3);
const awards = allAwards.slice(0, 3);
const [featuredVideo, ...moreVideos] = videos;
const featuredQuote = testimonials[0];
const sample = (key: string) => isPrototype && unconfirmed(key);

const sameAs = [
  !unconfirmed('instagram') && settings.instagram.url,
  !unconfirmed('facebook') && settings.facebook.url,
].filter(Boolean);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: settings.personName,
  description: settings.descriptor,
  url: Astro.site?.href,
  ...(sameAs.length ? { sameAs } : {}),
  ...(settings.businessName && !unconfirmed('names')
    ? { worksFor: { '@type': 'Organization', name: settings.businessName } }
    : {}),
};
---

<BaseLayout structuredData={structuredData}>
  <Hero />

  {
    awards.length > 0 && (
      <section class="section on-night spotlight" aria-labelledby="recognition-title">
        <div class="wrap">
          <div class="spot-head">
            <p class="credit">Recognition</p>
            <h2 id="recognition-title">Honoured for his work</h2>
          </div>
          <ul class="honour-grid">
            {awards.map(({ data }) => (
              <li class="honour-panel">
                <svg class="panel-arch" viewBox="0 0 100 125" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M0 125V48C0 22 30 9 50 0c20 9 50 22 50 48v77z" />
                </svg>
                <div class="panel-body">
                  {data.date && <p class="panel-year">{data.date.slice(0, 4)}</p>}
                  <h3>{data.title}</h3>
                  {data.issuer && <p class="panel-issuer">{data.issuer}</p>}
                  {data.date.length > 4 && <p class="panel-date">{formatPartialDate(data.date)}</p>}
                  {data.placeholder && <p class="panel-sample">Sample</p>}
                </div>
              </li>
            ))}
          </ul>
          <a class="more" href="/recognition">
            All awards and press <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )
  }

  {
    photos.length > 0 && (
      <section class="section" id="work" aria-labelledby="work-title">
        <div class="wrap">
          <div class="head-row">
            <h2 id="work-title">With the stars</h2>
            <a class="more" href="/gallery">
              Gallery <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
          <div class="mosaic">
            {photos.map((entry, i) => (
              <PhotoCard
                entry={entry}
                compact
                class={i === 0 ? 'tile-feature' : 'tile-side'}
                ratio={i === 0 ? 'fill' : 'landscape'}
                sizes={i === 0 ? '(min-width: 64rem) 46rem, 100vw' : '(min-width: 64rem) 30rem, (min-width: 40rem) 45vw, 100vw'}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    featuredVideo && (
      <section class="section on-night screening" id="videos" aria-labelledby="videos-title">
        <div class="wrap">
          <div class="head-row">
            <h2 id="videos-title">Watch</h2>
            <a class="more" href="/gallery">
              All videos <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
          <div class="screen-grid">
            <div class="screen-main">
              <VideoCard entry={featuredVideo} sizes="(min-width: 64rem) 52rem, 100vw" />
            </div>
            {moreVideos.length > 0 && (
              <div class="screen-side">
                {moreVideos.map((entry) => (
                  <VideoCard entry={entry} compact sizes="(min-width: 64rem) 26rem, 100vw" />
                ))}
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  {
    featuredQuote && (
      <section class="section quote-section" aria-label="What people say">
        <div class="wrap quote-wrap">
          <TestimonialCard entry={featuredQuote} featured />
        </div>
      </section>
    )
  }

  <section class="section on-red contact-band" aria-labelledby="contact-title">
    <div class="wrap contact-inner">
      <Diya size={64} />
      <h2 id="contact-title">Planning an event?<br />Speak to Bharat.</h2>
      <a class="contact-email" href={`mailto:${settings.email}`} data-track="contact_email_click" data-track-id="home">
        {settings.email}
      </a>
      {sample('email') && <p class="contact-sample">Sample address</p>}
      <div class="contact-buttons">
        <a class="button" href={`mailto:${settings.email}`} data-track="contact_email_click" data-track-id="home-button">Email Bharat</a>
        <a class="button button-outline" href={settings.instagram.url} data-track="social_click" data-track-id="instagram:home">Instagram</a>
        <a class="button button-outline" href={settings.facebook.url} data-track="social_click" data-track-id="facebook:home">Facebook</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.25rem);
  }
  .head-row h2 {
    margin: 0;
  }

  /* ---- Achievements spotlight ---- */
  .spotlight {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(60% 80% at 50% 0%, #3a1611 0%, transparent 70%),
      var(--night);
  }
  .spot-head {
    text-align: center;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
  }
  .spot-head h2 {
    margin: 0 auto;
  }
  .spot-head .credit {
    margin-inline: auto;
  }
  .honour-grid {
    display: grid;
    gap: 1.5rem;
    margin: 0 0 clamp(2.5rem, 2rem + 2vw, 3.5rem);
    padding: 0;
    list-style: none;
    justify-content: center;
  }
  @media (min-width: 48rem) {
    .honour-grid {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 22rem));
      gap: 2rem;
    }
  }
  .honour-panel {
    position: relative;
    display: grid;
    min-height: 19rem;
    padding: 4.5rem 2rem 2.25rem;
    text-align: center;
  }
  .panel-arch {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .panel-arch path {
    fill: rgb(233 162 59 / 0.06);
    stroke: var(--marigold);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .panel-body {
    position: relative;
    align-self: end;
  }
  .panel-year {
    margin: 0 auto 0.5rem;
    font-family: var(--font-display);
    font-size: 3rem;
    line-height: 1;
    color: var(--marigold);
  }
  .honour-panel h3 {
    margin: 0 auto 0.6rem;
    font-size: var(--display-m);
    color: var(--on-night);
  }
  .panel-issuer,
  .panel-date {
    margin: 0 auto;
    color: var(--on-night-2);
  }
  .panel-sample {
    margin: 0.75rem auto 0;
    font-size: var(--text-label);
    color: var(--marigold);
  }
  .spotlight .more {
    display: flex;
    width: fit-content;
    margin-inline: auto;
  }

  /* ---- Photo mosaic: one feature, three beside/below ---- */
  .mosaic {
    display: grid;
    gap: clamp(2rem, 1.25rem + 2vw, 2.75rem) clamp(1.25rem, 0.75rem + 1.5vw, 2rem);
  }
  @media (min-width: 40rem) {
    .mosaic {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .mosaic :global(.tile-feature) {
      grid-column: 1 / -1;
    }
    .mosaic :global(.tile-feature .photo) {
      aspect-ratio: 16 / 9;
    }
  }
  @media (min-width: 64rem) {
    .mosaic {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    }
    .mosaic :global(.tile-feature) {
      grid-column: 1;
      grid-row: span 2;
    }
    .mosaic :global(.tile-feature .photo) {
      aspect-ratio: auto;
    }
    .mosaic :global(.tile-side) {
      grid-column: 2;
    }
    .mosaic :global(.tile-side .photo) {
      aspect-ratio: 16 / 9;
    }
  }

  /* ---- Screening room ---- */
  .screening {
    background:
      radial-gradient(120% 70% at 50% 0%, #2c1612 0%, transparent 60%),
      var(--night);
  }
  .screen-grid {
    display: grid;
    gap: 2.5rem;
  }
  .screen-side {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 64rem) {
    .screen-grid {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      align-items: start;
    }
    .screen-main :global(.video-title) {
      font-size: var(--display-m);
    }
  }
  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .screen-side {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---- One featured quote ---- */
  .quote-wrap {
    max-width: 58rem;
  }

  /* ---- Contact band ---- */
  .contact-band {
    background:
      radial-gradient(90% 120% at 50% 0%, #8f1218 0%, transparent 60%),
      var(--sindoor-deep);
  }
  .contact-inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .contact-inner h2 {
    margin: 1rem 0 1.5rem;
    color: var(--paper);
  }
  .contact-email {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.1rem + 2.4vw, 3rem);
    line-height: 1.15;
    color: var(--marigold-soft);
    text-decoration-thickness: 0.05em;
    overflow-wrap: anywhere;
  }
  .contact-email:hover {
    color: #fff;
  }
  .contact-sample {
    margin: 0.4rem 0 0;
    font-size: var(--text-label);
    color: var(--marigold-soft);
  }
  .contact-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 2rem;
  }
</style>
