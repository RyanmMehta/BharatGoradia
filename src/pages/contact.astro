---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactActions from '../components/ContactActions.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
---

<BaseLayout title="Contact Bharat" description="Planning an event? Email Bharat Goradia, message him on Instagram or Facebook, or send a short enquiry.">
  <section class="section contact-top">
    <div class="container narrow">
      <p class="eyebrow">Contact</p>
      <h1>Planning an event? Get in touch with Bharat.</h1>
      <p class="lead">Email is the most direct way to reach him. You can also message him on Instagram or Facebook.</p>
      <ContactActions location="contact-page" />
    </div>
  </section>

  <section class="section section-tint" aria-labelledby="form-title">
    <div class="container narrow">
      <h2 id="form-title">Or send a short message</h2>
      <p class="lead">
        Bharat will reply by email. You do not need dates, budgets or artist names yet: just tell him what you are planning.
      </p>
      <EnquiryForm />
      <p class="privacy-note">
        Your details are used only to reply to your enquiry. <a href="/privacy">How your information is handled</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 52rem;
  }
  .contact-top {
    padding-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }
  .lead {
    font-size: clamp(1.25rem, 1.15rem + 0.4vw, 1.4375rem);
    color: var(--charcoal-soft);
    margin-bottom: 2rem;
  }
  .privacy-note {
    margin-top: 2rem;
    font-size: var(--text-support);
    color: var(--charcoal-soft);
  }
</style>
