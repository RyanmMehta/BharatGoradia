---
// No-JavaScript path for the enquiry form. Renders validation errors with the visitor's text kept,
// or the success message once the enquiry is stored. The enhanced form uses /api/enquiry instead.
import BaseLayout from '../../layouts/BaseLayout.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import { clientKey, enquiryDeps } from '../../lib/enquiry/runtime.ts';
import { FORM_ERRORS, submitEnquiry, type EnquiryResult } from '../../lib/enquiry/service.ts';

export const prerender = false;

if (Astro.request.method !== 'POST') return Astro.redirect('/contact', 303);

Astro.response.headers.set('Cache-Control', 'no-store');

let result: EnquiryResult;
try {
  const data = await Astro.request.formData();
  const raw: Record<string, unknown> = {};
  for (const [k, v] of data) if (typeof v === 'string') raw[k] = v;
  result = await submitEnquiry(raw, clientKey(Astro.request, () => Astro.clientAddress), enquiryDeps());
} catch (err) {
  console.error('[enquiry] unexpected failure', err);
  result = { ok: false, status: 500, formError: FORM_ERRORS.unavailable, values: { name: '', email: '', phone: '', message: '' } };
}

if (!result.ok) Astro.response.status = result.status;
---

<BaseLayout title={result.ok ? 'Enquiry received' : 'Please check your message'} description="Contact Bharat Goradia.">
  <section class="section">
    <div class="wrap narrow">
      {
        result.ok ? (
          <div class="success-page" data-celebrate>
            <h1>Thank you. Your enquiry has been received.</h1>
            <p class="lead">Bharat will reply to the email address you gave.</p>
            {result.id !== 'received' && <p>Your reference: <strong>{result.id}</strong></p>}
            <p>
              <a class="button button-outline" href="/">Return to the home page</a>
            </p>
          </div>
        ) : (
          <>
            <h1>Please check your message</h1>
            <p class="lead">Your message has not been sent yet. Everything you typed is still below.</p>
            <EnquiryForm
              values={result.values}
              errors={result.status === 422 ? result.errors : undefined}
              formError={result.status !== 422 ? result.formError : undefined}
            />
          </>
        )
      }
    </div>
  </section>
</BaseLayout>

<script>
  import { showerPetals } from '../../scripts/petals';
  if (document.querySelector('[data-celebrate]')) showerPetals();
</script>

<style>
  .narrow {
    max-width: 52rem;
  }
  .lead {
    font-size: clamp(1.25rem, 1.15rem + 0.4vw, 1.4375rem);
    color: var(--ink-2);
  }
</style>
