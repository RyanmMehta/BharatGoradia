---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="section">
    <div class="wrap">
      <h1>Sorry, we could not find that page</h1>
      <p>The page may have moved. These links will take you to the main parts of the website:</p>
      <ul class="links">
        <li><a href="/">Home</a></li>
        <li><a href="/gallery">Gallery & Videos</a></li>
        <li><a href="/recognition">Recognition</a></li>
        <li><a href="/contact">Contact Bharat</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    font-weight: 600;
  }
</style>
