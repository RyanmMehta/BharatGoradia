---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PhotoCard from '../components/PhotoCard.astro';
import VideoCard from '../components/VideoCard.astro';
import { publicCollection } from '../lib/site';

const PAGE_SIZE = 12;
const [photos, videos] = await Promise.all([publicCollection('photos'), publicCollection('videos')]);
---

<BaseLayout title="Gallery & Videos" description="Photographs and videos from events and appearances with Bharat Goradia.">
  <PageHeader
    credit="Gallery & Videos"
    title="Photographs and videos"
  />

  {
    videos.length > 0 && (
      <section class="section on-night" aria-labelledby="videos-title">
        <div class="wrap">
          <h2 id="videos-title" class="block-title">Videos</h2>
          <ul class="video-grid">
            {videos.map((entry) => (
              <li>
                <VideoCard entry={entry} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section" aria-labelledby="photos-title">
    <div class="wrap">
      <h2 id="photos-title" class="block-title">Photographs</h2>
      {
        photos.length === 0 ? (
          <p>New photographs will appear here soon.</p>
        ) : (
          <>
            <ul class="photo-grid" data-gallery data-page-size={PAGE_SIZE}>
              {photos.map((entry, i) => (
                <li class:list={['gallery-item', i >= PAGE_SIZE && 'gallery-extra']} data-gallery-item tabindex="-1">
                  <PhotoCard entry={entry} />
                </li>
              ))}
            </ul>
            <p class="gallery-status" role="status" data-gallery-status />
            {photos.length > PAGE_SIZE && (
              <p class="load-more-wrap">
                <button type="button" class="button button-outline" data-load-more hidden>
                  Show more photographs
                </button>
              </p>
            )}
          </>
        )
      }
    </div>
  </section>
</BaseLayout>

<script>
  // Explicit "Show more" (never infinite scroll). Without JavaScript every item is shown.
  const list = document.querySelector<HTMLElement>('[data-gallery]');
  const button = document.querySelector<HTMLButtonElement>('[data-load-more]');
  const status = document.querySelector<HTMLElement>('[data-gallery-status]');
  if (list && button && status) {
    const size = Number(list.dataset.pageSize) || 12;
    const all = [...list.querySelectorAll<HTMLElement>('[data-gallery-item]')];
    const hidden = () => all.filter((el) => el.classList.contains('gallery-extra') && !el.classList.contains('is-shown'));
    list.classList.add('is-enhanced');
    button.hidden = hidden().length === 0;
    button.addEventListener('click', () => {
      const batch = hidden().slice(0, size);
      batch.forEach((el) => el.classList.add('is-shown'));
      const shown = all.length - hidden().length;
      status.textContent = `Showing ${shown} of ${all.length} photographs.`;
      button.hidden = hidden().length === 0;
      batch[0]?.focus();
    });
  }
</script>

<style>
  .block-title {
    font-size: var(--display-m);
    margin-bottom: 2rem;
  }
  .photo-grid,
  .video-grid {
    display: grid;
    gap: 3rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 40rem) {
    .photo-grid,
    .video-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .photo-grid,
    .video-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .gallery-item:focus {
    outline: none;
  }
  .gallery-item:focus-visible {
    outline: 3px solid var(--sindoor);
    outline-offset: 6px;
  }
  /* Hidden only once the script has taken charge, so a script failure never strands items. */
  .photo-grid.is-enhanced .gallery-extra:not(.is-shown) {
    display: none;
  }
  .gallery-status:empty {
    display: none;
  }
  .gallery-status {
    margin-top: 1.5rem;
    font-weight: 700;
  }
  .load-more-wrap {
    margin-top: 2.5rem;
    text-align: center;
    max-width: none;
  }
</style>
