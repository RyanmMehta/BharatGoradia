---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoCard from '../components/PhotoCard.astro';
import VideoCard from '../components/VideoCard.astro';
import { publicCollection } from '../lib/site';

const PAGE_SIZE = 12;
const [photos, videos] = await Promise.all([publicCollection('photos'), publicCollection('videos')]);

// One curated reading order across photos and videos: editor order first, then newest dated items.
// Undated items are not given a fake date; they simply sort after dated items with the same order.
const items = [...photos, ...videos].sort(
  (a, b) => a.data.order - b.data.order || (b.data.date || '').localeCompare(a.data.date || ''),
);
---

<BaseLayout title="Gallery & Videos" description="Photographs and videos from events and appearances with Bharat Goradia.">
  <section class="section gallery-top">
    <div class="container">
      <p class="eyebrow">Gallery & Videos</p>
      <h1>Photographs and videos</h1>
      <p class="lead">Captions name the people pictured and the occasion. Videos play here when you press Play.</p>

      {
        items.length === 0 ? (
          <p>New photographs and videos will appear here soon.</p>
        ) : (
          <>
            <ul class="gallery grid grid-3" data-gallery data-page-size={PAGE_SIZE}>
              {items.map((entry, i) => (
                <li class:list={['gallery-item', i >= PAGE_SIZE && 'gallery-extra']} data-gallery-item tabindex="-1">
                  {entry.collection === 'videos' ? (
                    <VideoCard entry={entry} headingLevel="h2" />
                  ) : (
                    <PhotoCard entry={entry} headingLevel="h2" />
                  )}
                </li>
              ))}
            </ul>
            <p class="gallery-status" role="status" data-gallery-status />
            {items.length > PAGE_SIZE && (
              <p class="load-more-wrap">
                <button type="button" class="button button-secondary" data-load-more hidden>
                  Show more photos and videos
                </button>
              </p>
            )}
          </>
        )
      }
    </div>
  </section>
</BaseLayout>

<script>
  // Explicit "Show more" (never infinite scroll). Without JavaScript every item is shown.
  const list = document.querySelector<HTMLElement>('[data-gallery]');
  const button = document.querySelector<HTMLButtonElement>('[data-load-more]');
  const status = document.querySelector<HTMLElement>('[data-gallery-status]');
  if (list && button && status) {
    const size = Number(list.dataset.pageSize) || 12;
    const all = [...list.querySelectorAll<HTMLElement>('[data-gallery-item]')];
    const hidden = () => all.filter((el) => el.classList.contains('gallery-extra') && !el.classList.contains('is-shown'));
    list.classList.add('is-enhanced');
    button.hidden = hidden().length === 0;
    button.addEventListener('click', () => {
      const batch = hidden().slice(0, size);
      batch.forEach((el) => el.classList.add('is-shown'));
      const shown = all.length - hidden().length;
      status.textContent = `Showing ${shown} of ${all.length} photos and videos.`;
      button.hidden = hidden().length === 0;
      batch[0]?.focus();
    });
  }
</script>

<style>
  .gallery-top {
    padding-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }
  .lead {
    font-size: clamp(1.25rem, 1.15rem + 0.4vw, 1.4375rem);
    color: var(--charcoal-soft);
    margin-bottom: 2.5rem;
  }
  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .gallery-item {
    display: flex;
    flex-direction: column;
  }
  .gallery-item > :global(*) {
    flex: 1;
  }
  .gallery-item:focus {
    outline: none;
  }
  .gallery-item:focus-visible {
    outline: var(--focus);
    outline-offset: 6px;
  }
  /* Hidden only once the script below has taken charge, so a script failure never strands items. */
  .gallery.is-enhanced .gallery-extra:not(.is-shown) {
    display: none;
  }
  .gallery-status:empty {
    display: none;
  }
  .gallery-status {
    margin-top: 1.5rem;
    font-weight: 600;
  }
  .load-more-wrap {
    margin-top: 2rem;
    text-align: center;
    max-width: none;
  }
  /* Video cards keep their dark styling on the light gallery page. */
  .gallery :global(.video-card) {
    color: var(--on-night);
  }
  .gallery :global(.video-card a) {
    color: var(--gold-light);
  }
  .gallery :global(.video-card :focus-visible) {
    outline-color: var(--gold-light);
  }
</style>
