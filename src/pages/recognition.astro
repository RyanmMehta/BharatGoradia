---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import AwardCard from '../components/AwardCard.astro';
import { formatPartialDate, publicCollection } from '../lib/site';

const [awards, press] = await Promise.all([publicCollection('awards'), publicCollection('press')]);
---

<BaseLayout title="Recognition" description="Awards, honours and selected press coverage for Bharat Goradia.">
  <PageHeader credit="Recognition" title="Awards and press" />

  <section class="section" aria-labelledby="awards-title">
    <div class="wrap">
      <h2 id="awards-title" class="block-title">Awards and honours</h2>
      {
        awards.length ? (
          <div class="honours">
            {awards.map((entry) => (
              <AwardCard entry={entry} detailed headingLevel="h3" />
            ))}
          </div>
        ) : (
          <p>Details of awards and honours will be added soon.</p>
        )
      }
    </div>
  </section>

  {
    press.length > 0 && (
      <section class="section band" aria-labelledby="press-title">
        <div class="wrap">
          <h2 id="press-title" class="block-title">Selected press</h2>
          <ul class="press-list">
            {press.map(({ data }) => (
              <li class="press-item">
                <p class="press-meta">
                  {[data.publication, formatPartialDate(data.date)].filter(Boolean).join(' · ')}
                  {data.placeholder && <span class="sample-text"> · Sample</span>}
                </p>
                <h3>
                  <a href={data.url} data-track="press_click">
                    {data.title}
                  </a>
                </h3>
                {data.summary && <p>{data.summary}</p>}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .block-title {
    font-size: var(--display-m);
    margin-bottom: 1.5rem;
  }
  .honours {
    border-bottom: 1px solid var(--rule);
  }
  .press-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--ink);
  }
  .press-item {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .press-meta {
    margin: 0 0 0.4rem;
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sindoor);
  }
  .sample-text {
    margin-left: 0.2em;
    color: var(--ink-2);
    letter-spacing: 0.04em;
  }
  .press-item h3 {
    font-size: var(--display-m);
    margin-bottom: 0.4rem;
  }
  .press-item h3 a {
    color: var(--ink);
  }
  .press-item h3 a:hover {
    color: var(--sindoor);
  }
  .press-item p:last-child {
    margin-bottom: 0;
  }
</style>
