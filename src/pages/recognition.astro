---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import AwardCard from '../components/AwardCard.astro';
import { formatPartialDate, publicCollection, settings } from '../lib/site';

const [awards, press] = await Promise.all([publicCollection('awards'), publicCollection('press')]);
---

<BaseLayout title="Recognition" description="Awards, honours and press for Bharat Goradia, including the Bharat Gaurav Award and the Dadasaheb Phalke Icon Award Films 2020.">
  <PageHeader credit="Recognition" title="Awards and press" />

  {
    settings.philosophy && (
      <section class="philosophy-band" aria-label="His philosophy">
        <figure class="wrap philosophy">
          <blockquote>
            <p>“{settings.philosophy}”</p>
          </blockquote>
          {settings.signature && <figcaption>{settings.signature}</figcaption>}
        </figure>
      </section>
    )
  }

  <section class="section" aria-labelledby="awards-title">
    <div class="wrap">
      <h2 id="awards-title" class="block-title">Awards and honours</h2>
      {
        awards.length ? (
          <div class="honours">
            {awards.map((entry) => (
              <AwardCard entry={entry} detailed headingLevel="h3" />
            ))}
          </div>
        ) : (
          <p>Details of awards and honours will be added soon.</p>
        )
      }
    </div>
  </section>

  {
    press.length > 0 && (
      <section class="section band" aria-labelledby="press-title">
        <div class="wrap">
          <h2 id="press-title" class="block-title">Press and media</h2>
          <ul class="press-list">
            {press.map(({ data }) => (
              <li class="press-item">
                <p class="press-meta">
                  {[data.publication, formatPartialDate(data.date)].filter(Boolean).join(' · ')}
                  {data.placeholder && <span class="sample-text"> · Sample</span>}
                </p>
                <h3>
                  {data.url ? (
                    <a href={data.url} data-track="press_click">
                      {data.title}
                    </a>
                  ) : (
                    data.title
                  )}
                </h3>
                {data.summary && <p>{data.summary}</p>}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .philosophy-band {
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 4rem) 0;
  }
  .philosophy {
    margin-block: 0;
    padding-left: 1.5rem;
    border-left: 4px solid var(--marigold);
  }
  .philosophy blockquote {
    margin: 0;
  }
  .philosophy blockquote p {
    max-width: 30ch;
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: var(--display-m);
    line-height: 1.25;
    color: var(--text);
  }
  .philosophy figcaption {
    font-weight: 700;
    color: var(--marigold);
  }
  .block-title {
    font-size: var(--display-m);
    margin-bottom: 1.5rem;
  }
  .honours {
    border-bottom: 1px solid var(--line);
  }
  .press-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--gold-dim);
  }
  .press-item {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--line);
  }
  .press-meta {
    margin: 0 0 0.4rem;
    font-size: var(--text-label);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .sample-text {
    margin-left: 0.2em;
    color: var(--text-2);
    letter-spacing: 0.04em;
  }
  .press-item h3 {
    font-size: var(--display-m);
    margin-bottom: 0.4rem;
  }
  .press-item h3 a {
    color: var(--text);
  }
  .press-item h3 a:hover {
    color: var(--accent);
  }
  .press-item p:last-child {
    margin-bottom: 0;
  }
</style>
