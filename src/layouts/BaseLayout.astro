---
import '@fontsource/gloock/latin-400.css';
import '@fontsource-variable/atkinson-hyperlegible-next/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FestivalLights from '../components/FestivalLights.astro';
import { isPrototype, settings } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** Extra JSON-LD for the page; must reflect verified, visible information only. */
  structuredData?: object;
}

const { title, description = settings.seo.description || settings.introduction, structuredData } = Astro.props;
const fullTitle = title ? `${title} | ${settings.personName}` : `${settings.personName} | ${settings.descriptor}`;
// Pages are built as files (gallery.html), so normalise to the clean public path.
const cleanPath = Astro.url.pathname.replace(/(\/index)?\.html$/, '') || '/';
const canonical = new URL(cleanPath, Astro.site);
const ogImage = new URL('/og-default.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {isPrototype && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#f7f1e6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      structuredData && !isPrototype && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
      )
    }
    <script is:inline>
      // Progressive enhancement flags. Motion is opt-in: no reduced-motion preference,
      // no data-saver, and a browser that can run the reveal script. If that script has not
      // reported in after 2.5s, the flag is removed so no image stays hidden.
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          if (localStorage.getItem('decor-paused') === '1') root.classList.add('decor-paused');
        } catch (e) {}
        var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
        var saveData = navigator.connection && navigator.connection.saveData;
        if ('IntersectionObserver' in window && !reduce && !saveData) {
          root.classList.add('motion-ok');
          setTimeout(function () {
            if (!window.__revealReady) root.classList.remove('motion-ok');
          }, 2500);
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    {
      isPrototype && (
        <aside class="preview-bar" aria-label="Preview notice">
          <div class="wrap">
            <strong>Preview.</strong> Photos, videos and wording are samples awaiting approval. Hidden from search engines.
          </div>
        </aside>
      )
    }
    <div class="lights-bar">
      <FestivalLights />
      <button type="button" class="motion-toggle" data-motion-toggle hidden>
        <span class="mt-icon" aria-hidden="true"></span>
        <span data-motion-label>Pause animation</span>
      </button>
    </div>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { initClickTracking } from '../scripts/analytics';
      import { initReveal } from '../scripts/reveal';
      import { initMotionToggle } from '../scripts/motion-toggle';
      initClickTracking();
      initReveal();
      initMotionToggle();
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -10rem;
    z-index: 100;
    padding: 0.75rem 1.25rem;
    background: var(--ink);
    color: #fff;
    font-weight: 600;
    border-radius: 6px;
  }
  .skip-link:focus {
    top: 1rem;
  }
  main:focus {
    outline: none;
  }
  .lights-bar {
    position: relative;
  }
  .motion-toggle {
    position: absolute;
    top: 50%;
    right: max(0.5rem, calc((100% - var(--max)) / 2));
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 36px;
    padding: 0.3rem 0.85rem;
    border: 1px solid rgb(243 211 161 / 0.45);
    border-radius: 999px;
    background: rgb(18 12 10 / 0.88);
    color: var(--marigold-soft);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 700;
    cursor: pointer;
  }
  .motion-toggle:hover {
    background: var(--night-2);
    border-color: var(--marigold);
    color: #fff;
  }
  .motion-toggle:focus-visible {
    outline: 3px solid var(--marigold);
    outline-offset: 2px;
  }
  .mt-icon {
    width: 10px;
    height: 12px;
    border-left: 3px solid currentColor;
    border-right: 3px solid currentColor;
  }
  .motion-toggle[data-paused="true"] .mt-icon {
    width: 0;
    height: 0;
    border-right: 0;
    border-left: 10px solid currentColor;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
  }
  @media (prefers-reduced-motion: reduce) {
    .motion-toggle {
      display: none;
    }
  }
  .preview-bar {
    background: var(--night);
    color: var(--on-night-2);
    padding-block: 0.55rem;
    font-size: var(--text-label);
  }
  .preview-bar strong {
    color: var(--marigold);
  }
</style>
