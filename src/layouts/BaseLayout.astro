---
import '@fontsource/gloock/latin-400.css';
import '@fontsource-variable/atkinson-hyperlegible-next/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FestivalLights from '../components/FestivalLights.astro';
import { buildId, isPrototype, settings } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** Extra JSON-LD for the page; must reflect verified, visible information only. */
  structuredData?: object;
}

const { title, description = settings.seo.description || settings.introduction, structuredData } = Astro.props;
const fullTitle = title ? `${title} | ${settings.personName}` : `${settings.personName} | ${settings.descriptor}`;
// Pages are built as files (gallery.html), so normalise to the clean public path.
const cleanPath = Astro.url.pathname.replace(/(\/index)?\.html$/, '') || '/';
const canonical = new URL(cleanPath, Astro.site);
const ogImage = new URL('/og-default.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {isPrototype && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0f0b14" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      structuredData && !isPrototype && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
      )
    }
    <script is:inline>
      // Progressive enhancement flags. Motion is opt-in: no reduced-motion preference,
      // no data-saver, and a browser that can run the reveal script. If that script has not
      // reported in after 2.5s, the flag is removed so no image stays hidden.
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        // Festival lights "switch on" once per visit, only when motion is welcome.
        var calm = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
        try {
          if (!calm && !sessionStorage.getItem('lights-on')) {
            root.classList.add('lights-intro');
            sessionStorage.setItem('lights-on', '1');
            setTimeout(function () {
              if (!root.classList.contains('lights-ready')) root.classList.remove('lights-intro');
            }, 2500);
          }
        } catch (e) {}
        var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
        var saveData = navigator.connection && navigator.connection.saveData;
        if ('IntersectionObserver' in window && !reduce && !saveData) {
          root.classList.add('motion-ok');
          setTimeout(function () {
            if (!window.__revealReady) root.classList.remove('motion-ok');
          }, 2500);
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    {
      isPrototype && (
        <aside class="preview-bar" aria-label="Preview notice">
          <div class="wrap">
            <strong>Preview</strong> · sample photos and text{buildId && ` · version ${buildId}`}
          </div>
        </aside>
      )
    }
    <div class="lights-bar">
      <FestivalLights />
    </div>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { initClickTracking } from '../scripts/analytics';
      import { initReveal } from '../scripts/reveal';
      import { initLights } from '../scripts/lights';
      initLights();
      initClickTracking();
      initReveal();
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -10rem;
    z-index: 100;
    padding: 0.75rem 1.25rem;
    background: var(--text);
    color: var(--white);
    font-weight: 600;
    border-radius: 6px;
  }
  .skip-link:focus {
    top: 1rem;
  }
  main:focus {
    outline: none;
  }
  .lights-bar {
    position: relative;
    view-transition-name: festival-lights;
  }
  .preview-bar {
    background: var(--deep);
    color: var(--text-2);
    padding-block: 0.55rem;
    font-size: var(--text-label);
  }
  .preview-bar strong {
    color: var(--marigold);
  }
</style>
